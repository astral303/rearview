# Generated by `mise run homebrew-formula` in astral303/rearview.
# Edit scripts/homebrew-formula.rb.tmpl there, not this file.
class Rearview < Formula
  desc "Browse and search Claude Code, Codex, OpenCode, Kimi, Pi and OMP history"
  homepage "https://github.com/astral303/rearview"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/astral303/rearview/releases/download/v@VERSION@/rearview-darwin-arm64.tar.gz"
      sha256 "@DARWIN_SHA256@"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/astral303/rearview/releases/download/v@VERSION@/rearview-linux-amd64.tar.gz"
      sha256 "@LINUX_SHA256@"
    end
  end

  # The two platforms link ONNX Runtime differently. darwin-arm64 links it
  # statically, so its archive is a single binary. linux-amd64 loads it at run
  # time from a bundled `lib/`, and rearview resolves that relative to
  # `std::env::current_exe()` — so the binary has to stay in libexec beside
  # `lib/` and be reached through a wrapper. A bare symlink in `bin` would put
  # the executable path outside libexec, where the lookup fails.
  def install
    if OS.mac?
      bin.install "rearview"
    else
      libexec.install Dir["*"]
      (bin/"rearview").write_exec_script libexec/"rearview"
    end
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/rearview --version")
  end
end
