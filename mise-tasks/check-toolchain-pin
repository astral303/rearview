#!/usr/bin/env bash
#MISE description="Fail when rust-toolchain.toml and mise.lock pin a different rust version or components"
set -euo pipefail

sorted() { tr ',' '\n' | sort | paste -sd,; }

locked_version="$(awk '/^\[\[tools\.rust\]\]/{f=1} f&&/^version = /{gsub(/"/,"",$3);print $3;exit}' mise.lock)"
locked_components="$(awk '/^\[tools\.rust\.options\]/{f=1} f&&/^components = /{gsub(/"/,"",$3);print $3;exit}' mise.lock | sorted)"
pinned_version="$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)"
pinned_components="$(sed -n 's/^components = \[\(.*\)\]/\1/p' rust-toolchain.toml | tr -d '" ' | sorted)"

status=0
if [ "$locked_version" != "$pinned_version" ]; then
  echo "rust-toolchain.toml pins rust $pinned_version but mise.lock has $locked_version" >&2
  status=1
fi
if [ "$locked_components" != "$pinned_components" ]; then
  echo "rust-toolchain.toml pins components $pinned_components but mise.lock has $locked_components" >&2
  status=1
fi
exit "$status"
