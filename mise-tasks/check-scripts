#!/usr/bin/env bash
#MISE description="Fail when a bash task or script has a syntax error"
set -euo pipefail

# The release workflow runs several of these scripts and CI runs none of
# them, so without this a syntax error first shows when a release builds.
status=0
for file in mise-tasks/* scripts/*; do
  [ -f "$file" ] || continue
  head -n 1 "$file" | grep -q bash || continue
  bash -n "$file" || status=1
done
exit "$status"
