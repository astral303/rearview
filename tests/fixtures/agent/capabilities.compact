protocol agent-capabilities v=1 compatibility=same-major formats=compact,jsonl default=compact jsonl-schema=1
budget unit=unicode-scalar hard=true jsonl=whole-records
policy fields=tools,tool-results,thinking,subagents defaults=false,false,false,false
identity conversation=ch_ read=ch_:mN..mN focus=mN..mN project=pr_ uuid=uuid revision=rv_ anchor=ma_ guards=revision,anchor
diagnostics warning-v=1 error-v=1 warnings=stdout errors=stderr formats=compact,jsonl
continuation token=cu_ version=1 stale=stale-cursor local=true deterministic=true
command name=search family=agent-search v=5 formats=compact,jsonl continuation=cursor
command name=within family=agent-within v=5 formats=compact,jsonl continuation=cursor+revision
command name=outline family=agent-outline v=4 formats=compact,jsonl continuation=revision-guarded-read-range
command name=read family=agent-read v=4 formats=compact,jsonl continuation=revision-guarded-read-range+line-slice
grammar compact=records-lines atoms=percent-encoded ordering=header,metadata,data,continuation,warnings jsonl=tagged-object-per-line
